{
  "name": "@configdirector/js-sdks",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "build": "yarn workspaces foreach -A run build",
    "lint": "yarn workspaces foreach -A run lint",
    "coverage": "yarn workspaces foreach -A run coverage",
    "test": "yarn workspaces foreach -A run ci:test",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "version:bump": "yarn workspaces foreach -A --include '@configdirector/*-sdk' --include '@configdirector/openfeature-*' version"
  },
  "packageManager": "yarn@4.13.0"
}
