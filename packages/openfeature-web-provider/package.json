{
  "name": "@configdirector/openfeature-web-provider",
  "version": "1.2.0",
  "description": "OpenFeature web provider for ConfigDirector. ConfigDirector is a remote configuration and feature flag service.",
  "license": "MIT",
  "author": "ConfigDirector",
  "keywords": [
    "configdirector",
    "openfeature web provider",
    "openfeature provider",
    "openfeature",
    "web",
    "provider",
    "config",
    "configuration",
    "remote config",
    "remote configuration",
    "feature flag",
    "feature toggle",
    "feature switch"
  ],
  "homepage": "https://www.configdirector.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConfigDirector/js-sdks.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/configdirector-openfeature-web-provider.d.cts",
        "default": "./dist/configdirector-openfeature-web-provider.cjs"
      },
      "default": {
        "types": "./dist/configdirector-openfeature-web-provider.d.mts",
        "default": "./dist/configdirector-openfeature-web-provider.mjs"
      }
    }
  },
  "files": [
    "dist/*provider.*"
  ],
  "types": "dist/configdirector-openfeature-web-provider.d.mts",
  "browser": "dist/configdirector-openfeature-web-provider.mjs",
  "module": "dist/configdirector-openfeature-web-provider.mjs",
  "scripts": {
    "build": "tsdown",
    "verify:dist": "node ../../scripts/verify-dist-version.mjs",
    "clean": "rm -fr dist",
    "lint": "eslint .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "ci:test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "yarn clean && yarn lint && yarn ci:test && yarn build && yarn verify:dist && npm publish --access public"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msw/playwright": "^0.6.7",
    "@openfeature/core": "^1.11.0",
    "@openfeature/web-sdk": "^1.0.0",
    "@playwright/test": "1.60.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.7.0",
    "globals": "^17.3.0",
    "msw": "^2.12.9",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
