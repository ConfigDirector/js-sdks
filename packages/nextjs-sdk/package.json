{
  "name": "@configdirector/nextjs-sdk",
  "version": "1.0.0",
  "description": "Next.js SDK for ConfigDirector. ConfigDirector is a remote configuration and feature flag service.",
  "license": "MIT",
  "author": "ConfigDirector",
  "keywords": [
    "configdirector",
    "configdirector nextjs",
    "config",
    "configuration",
    "remote config",
    "remote configuration",
    "feature flag",
    "feature toggle",
    "feature switch",
    "nextjs"
  ],
  "homepage": "https://www.configdirector.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConfigDirector/js-sdks.git"
  },
  "type": "module",
  "exports": {
    "./server": {
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      },
      "default": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      }
    },
    "./client": {
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      },
      "default": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "verify:dist": "node ../../scripts/verify-dist-version.mjs",
    "clean": "rm -fr dist",
    "lint": "eslint .",
    "test": "vitest",
    "ci:test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "yarn clean && yarn lint && yarn ci:test && yarn build && yarn verify:dist && npm publish --access public"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.7.0",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "next": "^15.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@jsonjoy.com/json-pointer": "^18.1.0",
    "rapidhash-js": "^3.0.0",
    "semver": "^7.7.4"
  }
}
