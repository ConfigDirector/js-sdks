{
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "./dist",
    "paths": {
      "@eventsource/*": ["../eventsource/src/*"],
      "@js-client-core/*": ["../js-client-core/src/*"],
      "@js-browser-client/*": ["../js-browser-client/src/*"],
      "@shared/*": ["../shared/src/*"],
    },
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["vitest/globals"],
    "strict": true,
    // @testing-library/vue@8.1.0 imports RemoveIndexSignature from type-fest, an export
    // removed in type-fest v4. No upstream fix exists (8.1.0 is the latest release).
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "lib": [
      "ES2017",
      "DOM",
    ],
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
  },
  "exclude": ["dist", "node_modules"]
}
