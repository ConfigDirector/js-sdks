{
  "name": "@configdirector/server-sdk",
  "version": "0.2.3",
  "description": "Javascript server SDK for ConfigDirector. ConfigDirector is a remote configuration and feature flag service.",
  "license": "MIT",
  "author": "ConfigDirector",
  "keywords": [
    "configdirector",
    "config",
    "configuration",
    "remote config",
    "remote configuration",
    "feature flag",
    "feature toggle",
    "feature switch"
  ],
  "homepage": "https://www.configdirector.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConfigDirector/js-sdks"
  },
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/configdirector-server.d.cts",
        "default": "./dist/configdirector-server.cjs"
      },
      "default": {
        "types": "./dist/configdirector-server.d.mts",
        "default": "./dist/configdirector-server.mjs"
      }
    }
  },
  "files": [
    "dist/*server.*"
  ],
  "types": "dist/configdirector-server.d.mts",
  "module": "dist/configdirector-server.mjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist/**",
    "lint": "eslint .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "ci:test": "vitest run",
    "ci:test:bun": "bun run vitest run",
    "ci:test:deno": "deno run -A npm:vitest run",
    "release": "yarn clean && yarn lint && yarn ci:test && yarn build && npm publish --access public",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.5.0",
    "@types/semver": "^7",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "globals": "^17.3.0",
    "msw": "^2.12.9",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@jsonjoy.com/json-pointer": "^18.1.0",
    "rapidhash-js": "^3.0.0",
    "semver": "^7.7.4"
  }
}
