{
  "name": "@configdirector/nuxt-sdk",
  "version": "0.2.0",
  "description": "Nuxt SDK for ConfigDirector. ConfigDirector is a remote configuration and feature flag service.",
  "license": "MIT",
  "author": "ConfigDirector",
  "keywords": [
    "configdirector",
    "configdirector nuxt",
    "config",
    "configuration",
    "remote config",
    "remote configuration",
    "feature flag",
    "feature toggle",
    "feature switch"
  ],
  "homepage": "https://www.configdirector.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConfigDirector/js-sdks.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt prepare && tsdown",
    "prepack": "nuxt prepare && tsdown",
    "release": "yarn lint && yarn ci:test && yarn build && npm publish --access public",
    "lint": "eslint .",
    "ci:test": "vitest run",
    "test": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@jsonjoy.com/json-pointer": "^18.1.0",
    "@nuxt/kit": "^3.7.0 || ^4.0.0",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "rapidhash-js": "^3.0.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.2",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.1",
    "nuxt": "^4.4.6",
    "playwright": "^1.52.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.7",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7"
  }
}
