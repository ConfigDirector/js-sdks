#!/bin/sh
#
# pre-push: run the full verification suite before allowing a push.
#
#   yarn typecheck -> yarn lint -> yarn test -> yarn build
#
# Stops at the first failure. Bypass with:  git push --no-verify
#
# Installed by the root `postinstall` script, which points core.hooksPath at
# this directory. To wire it up by hand:  git config core.hooksPath .githooks

set -e

cd "$(git rev-parse --show-toplevel)"

# GUI git clients (VS Code, GitHub Desktop, JetBrains) often start without the
# shell profile, so an nvm-managed yarn will not be on PATH. Load it on demand.
if ! command -v yarn >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
    [ -f .nvmrc ] && nvm use >/dev/null 2>&1 || true
  fi
fi

if ! command -v yarn >/dev/null 2>&1; then
  echo "pre-push: 'yarn' was not found on PATH." >&2
  echo "  Push from a terminal, or bypass with: git push --no-verify" >&2
  exit 1
fi

if [ -t 1 ]; then
  bold=$(printf '\033[1m')
  red=$(printf '\033[31m')
  green=$(printf '\033[32m')
  yellow=$(printf '\033[33m')
  reset=$(printf '\033[0m')
else
  bold='' red='' green='' yellow='' reset=''
fi

# A remote with more than one pushurl (this repo mirrors to GitHub and GitLab)
# makes git invoke this hook once per URL — each time to verify the exact same
# commits. Cache the first result and let the follow-up invocations
# short-circuit.
#
# stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref. Only
# the local half goes into the key: the remote sha differs between hosts
# whenever they are out of sync, which would otherwise defeat the cache.
stamp="$(git rev-parse --absolute-git-dir)/pre-push-verified"
stamp_ttl=600
key=$(awk '{ print $1, $2 }' | sort | tr '\n' ';')
now=$(date +%s)

if [ -f "$stamp" ]; then
  prev_time=$(sed -n 1p "$stamp")
  prev_key=$(sed -n 2p "$stamp")
  case "$prev_time" in
    '' | *[!0-9]*) prev_time=0 ;;
  esac
  if [ "$prev_key" = "$key" ] && [ "$((now - prev_time))" -lt "$stamp_ttl" ]; then
    printf '\n%s✔ pre-push checks already passed for these commits — skipping%s\n' \
      "$yellow" "$reset"
    exit 0
  fi
fi

for step in typecheck lint test build; do
  printf '\n%s▶ yarn %s%s\n' "$bold" "$step" "$reset"
  if ! yarn "$step"; then
    printf '\n%s✖ pre-push failed at: yarn %s%s\n' "$red" "$step" "$reset" >&2
    printf '  Fix the failure, or bypass with: git push --no-verify\n' >&2
    exit 1
  fi
done

printf '%s\n%s\n' "$now" "$key" > "$stamp"

printf '\n%s✔ pre-push checks passed%s\n' "$green" "$reset"
