{
  "name": "@configdirector/openfeature-server-sample-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.local src/server.ts",
    "start": "node --env-file=.env.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "sdk:local": "node ../scripts/use-sdks.mjs local",
    "sdk:npm": "node ../scripts/use-sdks.mjs npm"
  },
  "dependencies": {
    "@configdirector/openfeature-server-provider": "^1.2.0",
    "@openfeature/core": "^1.11.0",
    "@openfeature/server-sdk": "^1.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "yarn@4.13.0",
  "configdirector": {
    "npmDependencies": {
      "@configdirector/openfeature-server-provider": "^1.2.0"
    }
  }
}
