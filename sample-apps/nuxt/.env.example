# Copy to .env, which `yarn dev` and `yarn start` load. Nuxt reads both keys at request time, so one
# build can serve every environment.

# Server-side SDK key, used by the Nitro server to render pages and answer GET /api/configs.
# Never sent to the browser.
NUXT_CONFIGDIRECTOR_SERVER_SDK_KEY=

# Client-side SDK key, used by the browser client after hydration.
NUXT_PUBLIC_CONFIGDIRECTOR_CLIENT_SDK_KEY=
